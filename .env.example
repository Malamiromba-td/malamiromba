# --- TathSchool: Courses (app/courses/page.tsx) ---
# Endpoint returning a list of courses. Accepts a bare array or an envelope
# like { "data": [...] } / { "courses": [...] }.
TATHSCHOOL_API_URL=https://tath.school/api/courses
TATHSCHOOL_API_KEY=

# --- TathSchool: Videos (app/videos/page.tsx) ---
# Separate endpoint for videos (may be the same host, different path).
TATHSCHOOL_VIDEOS_API_URL=
# Reuses TATHSCHOOL_API_KEY above if both endpoints share the same auth.

# --- Books (app/books/page.tsx) ---
# Point this at whichever storefront/API ends up hosting the books
# (Nestuge or otherwise). Same envelope handling, with { "books": [...] }
# also accepted.
BOOKS_API_URL=
BOOKS_API_KEY=

# --- TechInHausa Sanity: Blog (app/blog/page.tsx) ---
# TechInHausa's blog content lives in Sanity. Find these values in
# techinhausa.org's sanity.config file or the Sanity project dashboard.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2023-01-01
# Only needed if the dataset is private.
SANITY_API_TOKEN=
# Base URL used to build each post's link (defaults to https://techinhausa.org/blog).
TECHINHAUSA_BLOG_BASE_URL=https://techinhausa.org/blog
# Optional — override the default GROQ query in lib/data/blog.ts if
# TechInHausa's actual post schema uses different field names.
SANITY_BLOG_QUERY=

# --- Press (app/press/page.tsx) ---
# This page has no content — it redirects straight to a Google Drive folder
# with press assets. Paste the real Drive folder share link here.
PRESS_ASSET_KIT_URL=